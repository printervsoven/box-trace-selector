"""Headless acceptance suite for the independent full Cadabra trace engine."""

from collections import Counter
from fractions import Fraction
from pathlib import Path
import re

from cadabra2 import *


# Preserve every summand until this test explicitly calls ``collect_terms``.
# Cadabra's notebook/CLI kernel otherwise applies a default post-processor.
def post_process(expression, kernel=None):
    pass


CORE = Path("full_trace_calculator.cdb").resolve()
exec(compile(CORE.read_text(encoding="utf-8"), str(CORE), "exec"), globals())


def expression_term_count(expression):
    if expression == 0:
        return 0
    return sum(1 for _node in expression.top().terms())


# Universal ordered differential-operator inventories.
n1_operator = operator_terms(1)
n2_operator = operator_terms(2)
assert len(n1_operator) == 9
assert sum(len(term.coefficient.terms) for term in n1_operator) == 23
assert len(n2_operator) == 118
assert sum(len(term.coefficient.terms) for term in n2_operator) == 867
assert Counter(term.derivative_order for term in n2_operator) == {
    4: 1,
    3: 4,
    2: 21,
    1: 47,
    0: 45,
}
assert Counter(
    order
    for term in n2_operator
    for order in [term.derivative_order] * len(term.coefficient.terms)
) == {4: 1, 3: 6, 2: 56, 1: 259, 0: 545}
assert max(len(term.word) for term in n2_operator) == 4
print("PASS universal operators: n=1 9/23; n=2 118/867")


# Independent Cadabra Clifford check.  Cadabra performs the gamma algebra;
# the result is compared coefficient-and-pairing-wise with the standalone
# Wick recursion used by full_trace_calculator.cdb.
__cdbkernel__ = create_scope()
{a,b,c,d,e,f,g,h}::Indices(vector).
{i,j}::Indices(spinor).
Tr{#}::Trace(indices=spinor).
\eta{#}::KroneckerDelta.
\Gamma{#}::GammaMatrix(metric=\eta).
\Gamma{#}::ImplicitIndex(\Gamma{#}_{i j}).


def cadabra_bivector_trace(text, spinor_dimension=16, max_rank=8):
    output = Ex(text)
    for _iteration in range(12):
        before = str(output)
        join_gamma(output)
        distribute(output)
        untrace(output)
        distribute(output)
        canonicalise(output)
        collect_terms(output)
        if str(output) == before:
            break
    labels = list("abcdefgh")
    for rank in range(1, max_rank + 1):
        indices = " ".join(labels[:rank])
        substitute(output, Ex(r"Tr(\Gamma^{" + indices + r"}) -> 0"))
    substitute(output, Ex("Tr -> " + str(spinor_dimension)))
    distribute(output)
    rename_dummies(output)
    sort_product(output)
    canonicalise(output)
    collect_terms(output)
    return output


def cadabra_eta_term_map(expression):
    label_number = {label: number for number, label in enumerate("abcdefgh", 1)}
    result = []
    for term in expression.top().terms():
        coefficient = Fraction(str(term.multiplier))
        edges = []
        for factor in term.factors():
            assert factor.name == r"\eta"
            indices = tuple(label_number[index.name] for index in factor.indices())
            edges.append(("L", *sorted(indices)))
        result.append((coefficient, tuple(sorted(edges))))
    return tuple(sorted(result))


gamma_inputs = {
    2: r"Tr(\Gamma^{a b}\Gamma^{c d})",
    3: r"Tr(\Gamma^{a b}\Gamma^{c d}\Gamma^{e f})",
    4: r"Tr(\Gamma^{a b}\Gamma^{c d}\Gamma^{e f}\Gamma^{g h})",
}
for length, text in gamma_inputs.items():
    cadabra_map = cadabra_eta_term_map(cadabra_bivector_trace(text))
    labels = tuple(f"I{number}" for number in range(1, length + 1))
    recursive_map = tuple(sorted(bivector_trace_eta_terms(labels, "L")))
    assert cadabra_map == recursive_map
    assert len(cadabra_map) == {2: 2, 3: 8, 4: 60}[length]
print("PASS Cadabra Clifford maps: 2/8/60 metric pairings match exactly")


n1_expected = {
    "T": 8,
    "phi": 2,
    "BLL": 5,
    "BRR": 5,
    "UL": 5,
    "UR": 5,
    "ULLR": 8,
    "ULRR": 8,
    "B": 8,
    "U": 8,
    "chi": 5,
}
n2_expected = {
    "T": (404, 419, {4: 1, 3: 2, 2: 19, 1: 86, 0: 296}),
    "phi": (14, 14, {4: 1, 3: 2, 2: 5, 1: 6}),
    "BLL": (192, 222, {4: 1, 3: 2, 2: 12, 1: 46, 0: 131}),
    "BRR": (192, 222, {4: 1, 3: 2, 2: 12, 1: 46, 0: 131}),
    "UL": (192, 195, {4: 1, 3: 2, 2: 12, 1: 46, 0: 131}),
    "UR": (192, 195, {4: 1, 3: 2, 2: 12, 1: 46, 0: 131}),
    "ULLR": (404, 446, {4: 1, 3: 2, 2: 19, 1: 86, 0: 296}),
    "ULRR": (404, 446, {4: 1, 3: 2, 2: 19, 1: 86, 0: 296}),
    "B": (404, 446, {4: 1, 3: 2, 2: 19, 1: 86, 0: 296}),
    "U": (404, 446, {4: 1, 3: 2, 2: 19, 1: 86, 0: 296}),
    "chi": (192, 195, {4: 1, 3: 2, 2: 12, 1: 46, 0: 131}),
}

for field_name, expected_count in n1_expected.items():
    result = build_trace_result(field_name, 1)
    assert result.term_count == expected_count

for field_name, (expected_count, provenance, derivative_counts) in n2_expected.items():
    result = build_trace_result(field_name, 2)
    assert result.term_count == expected_count
    assert result.provenance_count == provenance
    assert result.derivative_counts == derivative_counts
    for row in result.terms:
        for forbidden in (
            r"\mathcal D",
            r"\Box",
            r"\mathcal G",
            r"\gamma",
            r"\bar\gamma",
            r"\eta",
            r"\bar\eta",
            "t_2",
            "t_3",
            "t_4",
        ):
            assert forbidden not in row.body_latex
print("PASS every n=1/n=2 single-field final-term inventory")


box_chunks = box_definition_latex_chunks()
assert len(box_chunks) == 3
main_box_source = "".join(box_chunks)
assert r"\Box T" in box_chunks[0]
assert r"\left(\Delta-\bar\Delta\right)T" in box_chunks[0]
assert r"\tag{2.6}" in box_chunks[0]
assert r"\Delta T" in box_chunks[1] and r"\tag{2.1}" in box_chunks[1]
assert r"\bar\Delta T" in box_chunks[2] and r"\tag{2.2}" in box_chunks[2]
for forbidden in (r"\mathcal A", r"\mathcal B", "h^C", "u^C", "b_{pq}"):
    assert forbidden not in main_box_source
field_boxes = tuple(field_box_latex(field) for field, _weight in normalize_combination(EIGHT_FIELD_COMBINATION))
assert len(field_boxes) == 8
assert r"\left(G^{q_1q_2}\phi\right)=0" in field_boxes[1]
assert r"\left(\bar G^{\bar q_1\bar q_2}\phi\right)=0" in field_boxes[1]
assert r"\left(\bar G^{\bar q_1\bar q_2}B_{LL}\right)=0" in field_boxes[2]
assert r"\left(G^{q_1q_2}B_{RR}\right)=0" in field_boxes[3]
assert (
    r"\left(\bar G^{\bar q_1\bar q_2}T\right)^{\alpha}{}_{\bar\beta}="
    r"-\frac12T^{\alpha}{}_{\bar\rho}"
    in field_boxes[0]
)
assert (
    r"(\gamma^{q_1q_2})^{\alpha}{}_{\rho}T^{\rho}{}_{\bar\beta}"
    in field_boxes[0]
)
assert r"U_{LRR}^{\alpha}{}_{\bar\rho\bar\beta_2}" in field_boxes[7]
assert r"U_{LRR}^{\alpha}{}_{\bar\beta_1\bar\rho}" in field_boxes[7]
assert r"\mathfrak R" not in field_boxes[1]
for field_box in field_boxes:
    for forbidden in (
        r"\mathcal A", r"\mathcal B", "h^C", "u^C", "b_{pq}",
        r"\gamma_{(", r"\bar\gamma_{(", r"\mathsf T", r"G_{",
    ):
        assert forbidden not in field_box
print("PASS main.pdf Box equations and all eight shorthand-free specializations")


prepared8 = prepare_field_variables(EIGHT_FIELD_COMBINATION, 2, show=False)
assert prepared8.variable_names == ("F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8")
assert tuple(variable.term_count for variable in prepared8.variables) == (
    404, 14, 192, 192, 192, 192, 404, 404
)
F1, F2, F3, F4, F5, F6, F7, F8 = prepared8.weighted_expressions
for variable, expression in zip(prepared8.variables, (F1, F2, F3, F4, F5, F6, F7, F8)):
    assert cadabra_term_count(expression) == variable.term_count, (
        variable.name, cadabra_term_count(expression), variable.term_count
    )
    assert re.search(r"\bK\d{4}\b", str(expression)) is None, variable.name
    assert re.search(r"\bK\d{4}\b", expression._latex_()) is None, variable.name
    for row_number, row in enumerate(variable.trace_result.terms, 1):
        assert tuple(row.body_expression.top().free_indices()) == (), (
            variable.name, row_number, cadabra_body_source(row.body_key)
        )
actual_tensor_source = " ".join(
    expression._latex_() for expression in (F1, F2, F3, F4, F5, F6, F7, F8)
)
for actual_head in ("H", "Gamma", "Phi", "Rfrak", r"\partial"):
    assert actual_head in actual_tensor_source, actual_head
totalTr = F1 + F2 + F3 + F4 + F5 + F6 + F7 + F8
assert cadabra_term_count(totalTr) == 1994
distribute(totalTr)
canonicalise(totalTr)
collect_terms(totalTr)
assert totalTr == 0
print("PASS visible actual-tensor workflow: totalTr = F1 + ... + F8 -> 0")


