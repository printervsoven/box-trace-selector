"""Headless acceptance suite for the independent full Cadabra trace engine."""

from collections import Counter
from fractions import Fraction
from pathlib import Path
import re

from cadabra2 import *


# Preserve every summand until this test explicitly calls ``collect_terms``.
# Cadabra's notebook/CLI kernel otherwise applies a default post-processor.
def post_process(expression, kernel=None):
    pass


CORE = Path("full_trace_calculator.cdb").resolve()
exec(compile(CORE.read_text(encoding="utf-8"), str(CORE), "exec"), globals())


def expression_term_count(expression):
    if expression == 0:
        return 0
    return sum(1 for _node in expression.top().terms())


# Universal ordered differential-operator inventories.
n1_operator = operator_terms(1)
n2_operator = operator_terms(2)
assert len(n1_operator) == 9
assert sum(len(term.coefficient.terms) for term in n1_operator) == 23
assert len(n2_operator) == 118
assert sum(len(term.coefficient.terms) for term in n2_operator) == 867
assert Counter(term.derivative_order for term in n2_operator) == {
    4: 1,
    3: 4,
    2: 21,
    1: 47,
    0: 45,
}
assert Counter(
    order
    for term in n2_operator
    for order in [term.derivative_order] * len(term.coefficient.terms)
) == {4: 1, 3: 6, 2: 56, 1: 259, 0: 545}
assert max(len(term.word) for term in n2_operator) == 4
print("PASS universal operators: n=1 9/23; n=2 118/867")


# Independent Cadabra Clifford check.  Cadabra performs the gamma algebra;
# the result is compared coefficient-and-pairing-wise with the standalone
# Wick recursion used by full_trace_calculator.cdb.
__cdbkernel__ = create_scope()
{a,b,c,d,e,f,g,h}::Indices(vector).
{i,j}::Indices(spinor).
Tr{#}::Trace(indices=spinor).
\eta{#}::KroneckerDelta.
\Gamma{#}::GammaMatrix(metric=\eta).
\Gamma{#}::ImplicitIndex(\Gamma{#}_{i j}).


def cadabra_bivector_trace(text, spinor_dimension=16, max_rank=8):
    output = Ex(text)
    for _iteration in range(12):
        before = str(output)
        join_gamma(output)
        distribute(output)
        untrace(output)
        distribute(output)
        canonicalise(output)
        collect_terms(output)
        if str(output) == before:
            break
    labels = list("abcdefgh")
    for rank in range(1, max_rank + 1):
        indices = " ".join(labels[:rank])
        substitute(output, Ex(r"Tr(\Gamma^{" + indices + r"}) -> 0"))
    substitute(output, Ex("Tr -> " + str(spinor_dimension)))
    distribute(output)
    rename_dummies(output)
    sort_product(output)
    canonicalise(output)
    collect_terms(output)
    return output


def cadabra_eta_term_map(expression):
    label_number = {label: number for number, label in enumerate("abcdefgh", 1)}
    result = []
    for term in expression.top().terms():
        coefficient = Fraction(str(term.multiplier))
        edges = []
        for factor in term.factors():
            assert factor.name == r"\eta"
            indices = tuple(label_number[index.name] for index in factor.indices())
            edges.append(("L", *sorted(indices)))
        result.append((coefficient, tuple(sorted(edges))))
    return tuple(sorted(result))


gamma_inputs = {
    2: r"Tr(\Gamma^{a b}\Gamma^{c d})",
    3: r"Tr(\Gamma^{a b}\Gamma^{c d}\Gamma^{e f})",
    4: r"Tr(\Gamma^{a b}\Gamma^{c d}\Gamma^{e f}\Gamma^{g h})",
}
for length, text in gamma_inputs.items():
    cadabra_map = cadabra_eta_term_map(cadabra_bivector_trace(text))
    labels = tuple(f"I{number}" for number in range(1, length + 1))
    recursive_map = tuple(sorted(bivector_trace_eta_terms(labels, "L")))
    assert cadabra_map == recursive_map
    assert len(cadabra_map) == {2: 2, 3: 8, 4: 60}[length]
print("PASS Cadabra Clifford maps: 2/8/60 metric pairings match exactly")


