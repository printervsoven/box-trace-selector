print("PASS same numerical relative weights also cancel the representation n=1 traces")


bad_combination = list(EIGHT_FIELD_COMBINATION)
bad_combination[-2] = ("ULLR", Fraction(-1, 63))
negative_control = sum_trace_combination(bad_combination, 2, show=False)
assert negative_control.cadabra_residual != 0, "negative residual vanished"
assert not negative_control.is_zero, "negative control reported zero"
assert negative_control.canonical_keys == 404
assert negative_control.zero_keys == 0
# The conservative audit keeps all 404 complete AST bodies distinct.  Once
# genuine tensor indices and commuting PD derivatives are canonicalised,
# Cadabra identifies 358 independent nonzero tensor structures.
assert expression_term_count(negative_control.cadabra_residual) == 358, (
    expression_term_count(negative_control.cadabra_residual),
    negative_control.canonical_keys,
)
print(
    "PASS negative control: changing -1/64 to -1/63 leaves "
    "404 nonzero ledger rows / 358 Cadabra-canonical tensor residuals"
)


print("ALL FULL-TRACE CADABRA TESTS PASSED")
